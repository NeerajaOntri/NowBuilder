# Copy to backend/.env and fill in. Generate keys with: python -m app.keys
NOWBUILDER_SECRET_KEY=
NOWBUILDER_ENCRYPTION_KEY=
NOWBUILDER_DATABASE_URL=sqlite:///./nowbuilder.db
NOWBUILDER_CORS_ORIGINS=http://localhost:5173
NOWBUILDER_ACCESS_TOKEN_MINUTES=720
# Address users open nowBuilder at (links in emails use it)
NOWBUILDER_PUBLIC_URL=http://localhost:5173

# Platform admins (comma-separated emails): only they see the Platform page, approve new
# workspaces and set each workspace's plan and limits.
NOWBUILDER_PLATFORM_ADMINS=
# open = new workspaces work at once; approval = they wait for a platform admin.
# Leave empty for the default: approval when hosted (NOWBUILDER_ENVIRONMENT=production), open locally.
NOWBUILDER_SIGNUP_MODE=
# Limits of the Standard plan: ServiceNow instances and members (other plans: Starter 1 / 2, Team 3 / 4, Business 5 / 10)
NOWBUILDER_MAX_INSTANCES=2
NOWBUILDER_MAX_MEMBERS=3

# Email (sign-up codes, password reset links, invites, approval notices). Any SMTP provider works.
# Locally you can leave NOWBUILDER_SMTP_HOST empty: emails then appear at http://localhost:5173/dev/outbox.
# Gmail (testing): smtp.gmail.com, port 587, starttls, your Gmail address + an App password.
# Brevo / Resend / SendGrid (production): use their SMTP host, port and key, and a verified sender domain.
NOWBUILDER_SMTP_HOST=
NOWBUILDER_SMTP_PORT=587
NOWBUILDER_SMTP_USER=
NOWBUILDER_SMTP_PASSWORD=
NOWBUILDER_SMTP_SECURITY=starttls
NOWBUILDER_MAIL_FROM=nowBuilder <no-reply@yourdomain.com>
# New accounts must confirm their email with a 6-digit code (keep true when hosted)
NOWBUILDER_REQUIRE_EMAIL_VERIFICATION=true

# Optional: address to pre-fill on the connect form. Leave empty: you connect any instance in the app.
NOWBUILDER_DEFAULT_INSTANCE_URL=
# Plans deploy when you click Deploy on the plan card. Set true to also deploy a plan straight
# after it passes the checks (Development/Test instances only).
NOWBUILDER_AUTO_DEPLOY=false
# After a deploy, leave nowBuilder's update set as your current update set, so the instance's
# update set picker shows it. false = put your previous update set back.
NOWBUILDER_KEEP_UPDATE_SET_CURRENT=true

# Flows: deployed with the ServiceNow SDK. With Node.js 20+ installed, nowBuilder sets the SDK
# project up by itself on the first flow (backend/data/sdk/). Nothing else to do.
NOWBUILDER_SDK_AUTO_SETUP=true
# Optional: force the scoped app name (x_<vendor prefix>_<name>, max 18 chars)
NOWBUILDER_SDK_SCOPE=
# Optional: use your own `now-sdk init` project instead of the automatic one
NOWBUILDER_SDK_PROJECT_DIR=
# Optional safety pin: only allow flow installs into this one instance. Leave empty to use any connected instance.
NOWBUILDER_SDK_INSTANCE_URL=
# true = activate flows on install (default); false = install them inactive
NOWBUILDER_SDK_ACTIVATE_FLOWS=true
# How long a chat deploy waits for a first-time SDK setup that's still running, and the limit for
# one setup step (npm install). Run `python -m app.sdk_setup` to do the setup up front.
NOWBUILDER_SDK_WAIT_SECONDS=300
NOWBUILDER_SDK_SETUP_TIMEOUT=3600

# Send Email bodies: the trigger record's values are written as Flow Designer pill references
# ({{trigger.current.field}}). Set to placeholders to install [Field] placeholders instead.
NOWBUILDER_FLOW_BODY_PILLS=references
